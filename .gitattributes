# ensure shell scripts always have LF line endings on all platforms
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
# The Kconfig fragment is read by merge_config.sh inside a Linux container; a CRLF checkout
# would turn every symbol into "CONFIG_X=y\r".
*.config text eol=lf
*.toml  text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.timer   text eol=lf
Dockerfile* text eol=lf
*.in    text eol=lf
